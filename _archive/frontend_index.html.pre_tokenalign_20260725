  .modal .err{color:#c0392b;font-size:.78rem;margin-top:8px;min-height:1em}
  /* ── 폴더형 정리(과목=폴더, 단원=통합카드) ── */
  #grid{display:block}
  .folder{border:1px solid var(--line);border-radius:14px;overflow:hidden;margin-bottom:16px;background:#fff;box-shadow:0 10px 30px -24px rgba(10,61,98,.5)}
  .folder-h{width:100%;display:flex;align-items:center;gap:10px;padding:14px 18px;background:var(--mist);border:none;border-bottom:1px solid var(--line);cursor:pointer;font-family:inherit;text-align:left}
  .folder.collapsed .folder-h{border-bottom:none}
  .fh-cat{font-size:.7rem;font-weight:800;color:var(--ocean);letter-spacing:.03em}
  .fh-name{font-family:var(--serif);font-weight:700;color:var(--deep);font-size:1.08rem}
  .fh-count{font-size:.76rem;color:var(--muted)}
  .fh-free{font-size:.7rem;font-weight:800;background:#e9f9ef;color:#1e8449;border-radius:12px;padding:3px 10px}
  .fh-chev{margin-left:auto;color:var(--muted);font-size:1rem;transition:transform .2s}
  .folder.collapsed .fh-chev{transform:rotate(-90deg)}
  .folder.collapsed .folder-b{display:none}
  .folder-b{padding:16px}
  .ugrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(270px,1fr));gap:14px}
  .card .crow{display:flex;align-items:center;gap:9px;margin-top:10px;padding:9px 0 11px;border-bottom:1px dashed var(--line)}
  .card .clab{font-size:.78rem;font-weight:800;color:var(--ocean)}
  .card .drow{display:flex;align-items:center;gap:9px;margin-top:9px}
  .dlab{flex:0 0 44px;text-align:center;font-size:.74rem;font-weight:800;border-radius:7px;padding:4px 0}
  .dlab.b{background:#eaf4fb;color:#1B6CA8}.dlab.a{background:#fff4e5;color:#9a5b00}.dlab.k{background:#fdecec;color:#c0392b}
  .dlab.all{flex-basis:auto;padding:4px 10px;background:#eef2f6;color:#5A7890}
  .dbtns{display:flex;gap:7px;flex-wrap:wrap}
  .card .dl{padding:8px 13px;font-size:.82rem}
  .dl.freebtn{background:#27ae60}.dl.freebtn:hover{background:#219150}
  .dl.ghost.freebtn{background:#fff;color:#1e8449;border-color:#27ae60}
</style>
</head>
