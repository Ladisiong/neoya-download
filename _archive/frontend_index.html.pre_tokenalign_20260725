<style>
  :root{--deep:#0A3D62;--ocean:#1B6CA8;--sky:#3498DB;--wave:#AED6F1;--mist:#EAF4FB;--line:#D6E9F5;--ink:#12222f;--muted:#5A7890;--serif:"Noto Serif KR",serif;--sans:"Pretendard","Noto Sans KR",system-ui,sans-serif}
  *{box-sizing:border-box;margin:0;padding:0}
  body{font-family:var(--sans);color:var(--ink);background:#fff;line-height:1.6;-webkit-font-smoothing:antialiased}
  .wrap{max-width:1000px;margin:0 auto;padding:0 20px}
  a{color:inherit;text-decoration:none}
  .hero{background:linear-gradient(155deg,#0A3D62,#1B6CA8);color:#fff;padding:48px 0 40px;text-align:center}
  .hero .logo{display:inline-flex;align-items:center;gap:9px;font-family:var(--serif);font-weight:700;font-size:1.5rem}
