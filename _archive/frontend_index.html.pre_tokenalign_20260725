  .notice{background:var(--mist);border-bottom:1px solid var(--line)}
  .notice .wrap{padding:14px 20px;font-size:.86rem;color:var(--muted)}
  .notice b{color:var(--deep)}
  .tabs{position:sticky;top:0;z-index:10;background:rgba(255,255,255,.94);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
  .tabs .wrap{display:flex;gap:7px;overflow-x:auto;padding:12px 20px}
