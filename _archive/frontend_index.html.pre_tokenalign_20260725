<script>
  // tmkim Apps Script 웹앱 URL(/exec). 백엔드 재배포로 URL이 바뀌면 여기만 교체.
  var APPS_SCRIPT_URL = "https://script.google.com/macros/s/AKfycbzsVNBCcCwLMavq8gcgYAx8p3ss5Xj9vue3vRmqeUziGIqnwySjZ_uK5gk-hlkrfKGl/exec";
  var LEAD_KEY = "neoul_lead_v1";
  var CATS = ["전체","국어","수학","영어","사탐","과탐","한국사","통합사회","통합과학"];
  var ALL = [], cur = "전체", pending = null;

  function esc(s){ return String(s).replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
  function getLead(){ try{ return JSON.parse(localStorage.getItem(LEAD_KEY)||'null'); }catch(e){ return null; } }
  function saveLead(o){ try{ localStorage.setItem(LEAD_KEY, JSON.stringify(o)); }catch(e){} }

  // 리드/다운로드 로그 전송 (fire-and-forget, PII는 본문에만)
  function logLead(email, grade, interest, material){
    try{
      var body = 'action=lead'
        + '&email=' + encodeURIComponent(email||'')
        + '&grade=' + encodeURIComponent(grade||'')
        + '&interest=' + encodeURIComponent(interest||'')
        + '&material=' + encodeURIComponent(material||'')
        + '&consent=Y'
        + '&ua=' + encodeURIComponent((navigator.userAgent||'').slice(0,180));
      fetch(APPS_SCRIPT_URL, { method:'POST', mode:'no-cors', credentials:'omit',
        headers:{'Content-Type':'application/x-www-form-urlencoded;charset=UTF-8'}, body: body });
    }catch(e){}
  }
  function startDownload(href){ if(href){ window.open(href, '_blank', 'noopener'); } }

  // 탭
  var tabsEl = document.getElementById('tabs');
  CATS.forEach(function(c){
    var b=document.createElement('button'); b.className='tab'+(c==='전체'?' on':''); b.textContent=c;
    b.onclick=function(){cur=c;[].forEach.call(tabsEl.children,function(x){x.classList.remove('on')});b.classList.add('on');render();};
    tabsEl.appendChild(b);
  });

  function fail(msg){
    document.getElementById('state').innerHTML='⚠️ 자료를 불러오지 못했습니다.<br/><span style="font-size:.82rem">'+(msg||'잠시 후 새로고침해 주세요.')+'</span>';
  }

  function catIdx(c){ var i=CATS.indexOf(c); return i<0?99:i; }
  // 단원명에서 난이도(· 기본/심화/킬러) 분리 → 통합 카드용
  function parseUnit(u){
    var m=String(u||'').match(/^([\s\S]*?)\s*·\s*(기본|심화|킬러)\s*$/);
    return m ? {base:m[1].trim(), diff:m[2]} : {base:String(u||'').trim(), diff:null};
  }
  function dlBtn(f, matBase, typeLabel, cat){
    var free=!!f.sample, mat=matBase+'_'+f.type;
    return '<button class="dl'+(f.type==='해설편'?' ghost':'')+(free?' freebtn':'')+'" data-href="'+esc(f.download)+
      '" data-mat="'+esc(mat)+'" data-cat="'+esc(cat)+'" data-free="'+(free?'1':'')+'">⬇ '+esc(typeLabel||f.type)+'</button>';
  }
  function render(){
    var grid=document.getElementById('grid'), state=document.getElementById('state'), hook=document.getElementById('hook');
    var items = cur==='전체' ? ALL : ALL.filter(function(x){return x.category===cur;});
    // 과목(폴더) 단위로 묶기
    var subs={};
    items.forEach(function(x){ var sk=x.category+'|'+x.subject; (subs[sk]=subs[sk]||[]).push(x); });
    var subKeys=Object.keys(subs).sort(function(a,b){ var xa=subs[a][0], xb=subs[b][0];
      return catIdx(xa.category)-catIdx(xb.category) || String(xa.subject).localeCompare(String(xb.subject),'ko'); });
    if(subKeys.length===0){ hook.style.display='none'; state.style.display='block'; grid.style.display='none'; state.innerHTML='해당 과목의 자료가 아직 없습니다.'; return; }
    hook.style.display='flex'; state.style.display='none'; grid.style.display='block'; grid.innerHTML='';
    var dorder=['기본','심화','킬러','_'];
    var startCollapsed = subKeys.length > 6;  // 과목이 많으면(전체 보기 등) 접힌 채로 = 깔끔한 폴더 목록

    subKeys.forEach(function(sk){
      var sarr=subs[sk], cat0=sarr[0].category, subj0=sarr[0].subject;
      // 단원(base) 그룹화
      var units={};
      sarr.forEach(function(x){ var pu=parseUnit(x.unit); x._diff=pu.diff; (units[pu.base]=units[pu.base]||[]).push(x); });
      var uKeys=Object.keys(units).sort(function(a,b){ return String(a).localeCompare(String(b),'ko'); });
      var subjFree=sarr.some(function(x){return x.sample;});

      var folder=document.createElement('section'); folder.className='folder'+(startCollapsed?' collapsed':'');
      folder.innerHTML='<button class="folder-h" type="button">'
        +'<span class="fh-cat">'+esc(cat0)+'</span>'
        +'<span class="fh-name">'+esc(subj0)+'</span>'
        +'<span class="fh-count">'+uKeys.length+'개 단원</span>'
        +(subjFree?'<span class="fh-free">🎁 이번 주 무료</span>':'')
        +'<span class="fh-chev">▾</span></button>';
      var body=document.createElement('div'); body.className='folder-b';
      var g=document.createElement('div'); g.className='ugrid';

      uKeys.forEach(function(ub){
        var arr=units[ub];
        var free=arr.some(function(x){return x.sample;});
        var topic=''; for(var i=0;i<arr.length;i++){ if(arr[i].topic){topic=arr[i].topic;break;} }
        var matBase=cat0+'_'+subj0+'_'+ub;
        var concept=null, diffs={};
        arr.forEach(function(x){ if(x.type==='개념요약'){concept=x;return;} var d=x._diff||'_'; (diffs[d]=diffs[d]||{})[x.type]=x; });
        var html='<div class="subj">'+esc(cat0)+' · '+esc(subj0)+'</div>'
          +'<div class="unit">'+esc(ub)+'</div>'
          +(topic?'<div class="topic">'+esc(topic)+'</div>':'')
          +(free?'<span class="badge free">🎁 이번 주 무료 단원</span>':'<span class="badge lock">🔒 무료 회원 전용</span>');
        if(concept){ html+='<div class="crow"><span class="clab">📘 개념요약</span>'+dlBtn(concept, matBase, '개념요약', cat0)+'</div>'; }
        dorder.forEach(function(d){
          var slot=diffs[d]; if(!slot) return;
          var lbl = d==='_' ? '<span class="dlab all">문제·해설</span>' : '<span class="dlab '+(d==='기본'?'b':d==='심화'?'a':'k')+'">'+d+'</span>';
          var btns='';
          ['문제편','해설편'].forEach(function(t){ if(slot[t]) btns+=dlBtn(slot[t], matBase+(d==='_'?'':'_'+d), t, cat0); });
          if(btns) html+='<div class="drow">'+lbl+'<span class="dbtns">'+btns+'</span></div>';
        });
        var card=document.createElement('div'); card.className='card'+(free?' free':''); card.innerHTML=html;
        g.appendChild(card);
      });
      body.appendChild(g); folder.appendChild(body); grid.appendChild(folder);
    });
  }

  // 다운로드 클릭 → (무료 샘플=바로 / 그 외=무료 회원가입 게이팅)
  document.getElementById('grid').addEventListener('click', function(e){
    var fh = e.target.closest('.folder-h');
    if(fh){ if(fh.parentNode) fh.parentNode.classList.toggle('collapsed'); return; }
    var b = e.target.closest('.dl'); if(!b) return;
    var href=b.getAttribute('data-href'), mat=b.getAttribute('data-mat'), cat=b.getAttribute('data-cat'), free=b.getAttribute('data-free')==='1';
    var lead=getLead();
    if(free){ if(lead&&lead.done) logLead(lead.email,lead.grade,lead.interest,mat+'#sample'); startDownload(href); return; }
    if(lead && lead.done){ logLead(lead.email, lead.grade, lead.interest, mat); startDownload(href); return; }
    openModal(href, mat, cat);
  });

  // 모달
  var modalBg=document.getElementById('modalBg');
  function openModal(href, mat, cat){
    pending={href:href, mat:mat};
    document.getElementById('fErr').textContent='';
    var sel=document.getElementById('fInterest');
    if(cat && cat!=='전체'){ for(var i=0;i<sel.options.length;i++){ if(sel.options[i].value===cat){ sel.selectedIndex=i; break; } } }
    modalBg.classList.add('on');
    setTimeout(function(){ document.getElementById('fEmail').focus(); }, 60);
  }
  function closeModal(){ modalBg.classList.remove('on'); pending=null; }
  document.getElementById('modalClose').onclick=closeModal;
  modalBg.addEventListener('click', function(e){ if(e.target===modalBg) closeModal(); });

  document.getElementById('fSubmit').onclick=function(){
    var email=document.getElementById('fEmail').value.trim();
    var grade=document.getElementById('fGrade').value;
    var interest=document.getElementById('fInterest').value;
    var agree=document.getElementById('fAgree').checked;
    var err=document.getElementById('fErr');
    if(!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)){ err.textContent='올바른 이메일을 입력해 주세요.'; return; }
    if(!agree){ err.textContent='개인정보 수집·이용 동의가 필요합니다.'; return; }
    logLead(email, grade, interest, pending?pending.mat:'');
    saveLead({email:email, grade:grade, interest:interest, done:1});
    var href = pending?pending.href:null;
    closeModal();
    startDownload(href);
  };

  var hookCtaEl=document.getElementById('hookCta');
  if(hookCtaEl){ hookCtaEl.onclick=function(){ openModal(null, 'hook_cta', cur==='전체'?'':cur); }; }

  (function load(){
    // 자료 목록 = Vercel 호스팅 매니페스트(same-origin).
    fetch('materials.json?t='+Date.now(),{cache:'no-store'})
      .then(function(r){ if(!r.ok) throw 0; return r.json(); })
      .then(function(res){
        ALL=(res&&res.items)||[];
        ALL.forEach(function(x){ x.download='materials/'+encodeURIComponent(x.file); if(!x.provenance) x.provenance=(res&&res.provenance)||'SKY 멘토 × AI 협업 출제'; });
        render();
      })
      .catch(function(){ fail('자료를 불러오지 못했습니다. 잠시 후 새로고침해 주세요.'); });
  })();
</script>
</body>
</html>
